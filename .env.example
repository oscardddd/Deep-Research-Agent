TAVILY_API_KEY=tvly-your-key
DEEPSEEK_API_KEY=sk-your-key

# Optional official DeepResearch Bench evaluator. RACE uses OpenAI; FACT also
# uses Jina Reader to fetch and verify cited pages.
LLM_BACKEND=openai
OPENAI_API_KEY=sk-your-key
JINA_API_KEY=jina-your-key

# Current inexpensive defaults. Override without changing application code.
DEEPSEEK_PLANNER_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_AUDIT_MODEL=deepseek-v4-pro

# Optional unified model-gateway policy. Budget is per research run. A value
# of 0 disables the hard limit. Prices are USD per million input/output tokens.
MODEL_GATEWAY_BUDGET_USD=0
MODEL_GATEWAY_PREMIUM_THRESHOLD=0.85
MODEL_GATEWAY_CONTEXT_WINDOW=128000
MODEL_GATEWAY_PRICING_JSON={"deepseek-v4-pro":{"input":0,"output":0},"deepseek-v4-flash":{"input":0,"output":0}}

# Per-stage ceilings. Initial workers do not share a global search-call cap.
MAX_INITIAL_TASKS=6
MAX_RECONNAISSANCE_QUERIES=2
MAX_REPLAN_ROUNDS=2
MAX_NEW_TASKS_PER_REPLAN=3
# Total supervisor input allowance; raw evidence is packed into the remainder
# after the persisted research digest and output reserve.
REPLAN_CONTEXT_TOKEN_BUDGET=24000
# Small audits use one model call. Larger audits are split across bounded
# dimension specialists, then reduced from structured verdicts only.
SINGLE_AUDIT_CONTEXT_TOKEN_BUDGET=30000
AUDIT_EVIDENCE_TOKEN_BUDGET_PER_CHECK=12000
MAX_AUDIT_SPECIALISTS=4
MAX_QUERY_CANDIDATES_PER_WORKER=3
MAX_QUERIES_PER_WORKER=2
MAX_ADAPTIVE_STEPS=6
MAX_RESULTS_PER_SEARCH=5
PAGE_CHUNK_CHARS=12000
# Rank paragraph-aware 500-token child chunks, then expand nearby hits into at
# most two larger windows for evidence extraction.
RETRIEVAL_CHUNK_TOKENS=500
RETRIEVAL_CHUNK_OVERLAP_TOKENS=75
EXTRACTION_WINDOW_TOKENS=1800
MAX_RETRIEVAL_CHUNKS_PER_SOURCE=4
MAX_EXTRACTION_WINDOWS_PER_SOURCE=2

# Optional hybrid retrieval: BM25 and Qwen rankings fused with weighted RRF.
# The default below targets a local Ollama server. Leave the base URL blank to
# keep BM25-only behavior, or replace it with an Alibaba Model Studio /v1 URL.
QWEN_EMBEDDING_BASE_URL=http://localhost:11434/v1
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_MODEL=qwen3-embedding:0.6b
QWEN_EMBEDDING_DIMENSIONS=512
QWEN_EMBEDDING_BATCH_SIZE=10
HYBRID_EMBEDDING_WEIGHT=0.35
HYBRID_RRF_K=60
# Start local Ollama with a real run and stop it when that run exits.
MANAGE_LOCAL_EMBEDDING_SERVICE=true

# Timeout for each Tavily or DeepSeek HTTP request.
REQUEST_TIMEOUT_SECONDS=45
